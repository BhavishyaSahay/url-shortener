# Copy this file to .env and fill in real values:  cp .env.example .env
# Never commit .env. It is listed in .gitignore.

# --- Application (Phase 1) ---------------------------------------------------
NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Public base URL used to build short links (https://short.ly/aB92x)
APP_BASE_URL=http://localhost:3000
SHUTDOWN_TIMEOUT_MS=10000

# --- PostgreSQL (Phase 2) ----------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/url_shortener?schema=public

# --- Authentication (Phase 3) ------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# --- Redis (Phase 5) ---------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Kafka (Phase 6) ---------------------------------------------------------
# Comma-separated list of brokers
KAFKA_BROKERS=localhost:9092
