# Copy this file to .env and fill in real values:  cp .env.example .env
# Never commit .env. It is listed in .gitignore.

# --- Application (Phase 1) ---------------------------------------------------
NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Public base URL used to build short links (https://short.ly/aB92x)
APP_BASE_URL=http://localhost:3000
SHUTDOWN_TIMEOUT_MS=10000

# --- PostgreSQL (Phase 2) ----------------------------------------------------
# Used by docker-compose.yml to create the local database container.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=url_shortener
# Host port for the container (5433 avoids clashing with a local Postgres on 5432)
POSTGRES_PORT=5433

# Used by the app and the Prisma CLI.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/url_shortener
# Max connections in this process's pool. Keep (instances x pool size) well below
# Postgres max_connections (default 100).
DB_POOL_MAX=10
# Integration tests use their own database, which is wiped on every test run.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/url_shortener_test

# --- Authentication (Phase 3) ------------------------------------------------
# REQUIRED, min 32 chars. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
# How long a login lasts: seconds, or 30s / 15m / 12h / 7d
JWT_EXPIRES_IN=1d
# Only send the auth cookie over HTTPS. Defaults to true when NODE_ENV=production.
# COOKIE_SECURE=false

# --- Redis (Phase 5) ---------------------------------------------------------
# Host port for the container (6380 avoids clashing with a local Redis on 6379)
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380/0
# Integration tests use a separate logical database (/1), which is flushed between tests.
TEST_REDIS_URL=redis://localhost:6380/1
# How long a short code -> URL lookup stays cached (seconds, or 30s / 15m / 1h / 1d)
URL_CACHE_TTL=1h
# How long a "this short code doesn't exist" result is cached (limits DB load from bad codes)
URL_NEGATIVE_CACHE_TTL=60s

# --- Rate limiting (Phase 5): fixed window, stored in Redis -------------------
# Login: max attempts per window, counted per IP AND per email
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW=15m
# URL creation: max per window, per user
RATE_LIMIT_CREATE_URL_MAX=30
RATE_LIMIT_CREATE_URL_WINDOW=1m

# --- Networking --------------------------------------------------------------
# Number of reverse proxies in front of the app (0 locally, 1 behind Nginx).
# Needed so req.ip is the real client IP from X-Forwarded-For, not the proxy's.
TRUST_PROXY=0

# --- Kafka (Phase 6) ---------------------------------------------------------
# Comma-separated list of brokers. From your Mac: localhost:9092.
# From containers on the Docker network (Phase 7): kafka:19092
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=url-shortener
# Topic that redirect click events are published to
KAFKA_CLICKS_TOPIC=url-clicks
KAFKA_CLICKS_PARTITIONS=3
# Consumer group of the analytics worker. Instances in one group share the partitions.
KAFKA_CONSUMER_GROUP=analytics-worker
