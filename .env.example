# Copy to .env and fill in:  cp .env.example .env   (never commit .env)

NODE_ENV=development
PORT=3000
LOG_LEVEL=info
APP_BASE_URL=http://localhost:3000

# The Docker containers from docker-compose.yml (host ports 5433 and 6380)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/url_shortener
REDIS_URL=redis://localhost:6380

# Required, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# true only when the site is served over HTTPS
COOKIE_SECURE=false
# Number of proxies in front of the app (0 when running it directly)
TRUST_PROXY=0
