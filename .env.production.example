# Production environment for docker-compose.prod.yml.
#
# On the server: copy to .env next to docker-compose.prod.yml, fill in real
# values, and restrict it to the deploy user:
#   cp .env.production.example .env && chmod 600 .env
# Never commit the real file. It's covered by .gitignore.

# --- Images (pushed by CI/CD, Phase 8) ----------------------------------------
# Image names are <IMAGE_PREFIX>-api, <IMAGE_PREFIX>-worker, <IMAGE_PREFIX>-migrate
IMAGE_PREFIX=ghcr.io/<github-user>/url-shortener
# A specific git commit SHA is better than "latest": you know exactly what's running.
IMAGE_TAG=latest

# --- Application ---------------------------------------------------------------
# Public URL users will see in short links
APP_BASE_URL=http://<server-public-ip-or-domain>
API_REPLICAS=2
LOG_LEVEL=info
# REQUIRED. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d
# Must be false until HTTPS is configured (browsers drop Secure cookies over plain HTTP)
COOKIE_SECURE=false

# --- PostgreSQL ------------------------------------------------------------------
POSTGRES_USER=urlshortener
# REQUIRED. Generate: openssl rand -base64 32 | tr -d '/+='
POSTGRES_PASSWORD=
POSTGRES_DB=url_shortener
