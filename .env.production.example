# The server's .env (in /opt/url-shortener, next to docker-compose.prod.yml).
# Never commit the real file.

IMAGE=ghcr.io/<github-username-lowercase>/url-shortener
IMAGE_TAG=latest
APP_BASE_URL=http://<server-ip>

# Generate random values, e.g.: head -c 48 /dev/urandom | base64
JWT_SECRET=
POSTGRES_PASSWORD=
